# ==============================================================================
# SHIKSHAAI ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your local credentials before running.
# ==============================================================================

# ── 1. Database Configuration ─────────────────────────────────────────────────
# SQLite (Default for quick local development):
DATABASE_URL=sqlite:///./shikshaai.db

# PostgreSQL via Docker Compose (Recommended for production/testing):
# DATABASE_URL=postgresql://shiksha_user:shiksha_password@localhost:5432/shikshaai
POSTGRES_DB=shikshaai
POSTGRES_USER=shiksha_user
POSTGRES_PASSWORD=shiksha_password
POSTGRES_PORT=5432

# ── 2. Security & Authentication ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_replace_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 3. AI & LLM Provider Credentials ──────────────────────────────────────────
# Obtain a free Google Gemini 1.5 Flash API Key at: https://aistudio.google.com
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── 4. CORS & Network Security ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 5. Frontend Public Configuration ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
