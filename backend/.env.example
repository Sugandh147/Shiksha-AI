# ShikshaAI Backend Environment Template
# Copy this to backend/.env — OR just run scripts/setup.ps1 (Windows) / scripts/setup.sh (Mac/Linux)
# which creates backend/.env automatically.

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=ShikshaAI
APP_VERSION=1.0.0
DEBUG=True

# ── Database (SQLite — zero config, no Docker needed) ─────────────────────────
DATABASE_URL=sqlite:///./shikshaai.db

# ── JWT Authentication ─────────────────────────────────────────────────────────
SECRET_KEY=your_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google Gemini AI  ──────────────────────────────────────────────────────────
# Get a FREE API key at https://aistudio.google.com
# Without this key the AI Tutor gracefully falls back to local NCERT templates.
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
